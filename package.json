{
  "name": "AIVIS",
  "version": "0.1.0",
  "private": true,
  "description": "AI 电商视觉策划助手 — 上传商品图，自动生成主图、详情页与 AI 提示词",
  "author": "AIVIS Team",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:build": "next build && electron-builder --mac",
    "electron:build:dir": "next build && electron-builder --mac --dir"
  },
  "build": {
    "appId": "com.aivis.ecommerce-planner",
    "productName": "AIVIS",
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      ".next/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json",
      "public/**/*"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.business",
      "minimumSystemVersion": "13.0"
    },
    "dmg": {
      "title": "AIVIS Installer"
    },
    "asarUnpack": [
      "node_modules/next/**/*"
    ]
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "openai": "^6.42.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
