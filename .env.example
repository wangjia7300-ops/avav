# ── 服务端默认文案/视觉模型 ──────────────────────────────────────
# 优先使用火山方舟 Ark；未配置时回退 OPENAI_API_KEY。
# 配置后，工作台无需把 API Key 保存到浏览器；页面中的独立配置仍可覆盖它。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1-8-251228

# OpenAI 回退（可选）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── 可选调优 ────────────────────────────────────────────────────
# 文本模型单次请求超时（毫秒，10000–300000，默认 180000）
# AI_REQUEST_TIMEOUT_MS=180000
# 文本模型传输层重试次数（0–2，默认 2）
# AI_MAX_TRANSPORT_RETRIES=2
# 生图请求超时（毫秒，默认 180000）
IMAGE_REQUEST_TIMEOUT_MS=180000

# ── 说明 ────────────────────────────────────────────────────────
# 本应用为本地单机模式：无登录、无云端数据库、无用户系统。
# 生图使用独立的「生图模型」配置（浏览器持久化键 image-provider-config），
# 绝不复用 OPENAI_API_KEY。
# 注意：API 路由本身没有鉴权。若部署到公网，任何人都可能消耗上面配置的
# 服务端模型额度——公网部署前必须自行加上访问控制（反向代理鉴权等）。
