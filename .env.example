OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 火山方舟 Ark（服务端默认文案/视觉模型）
# 配置后，工作台无需把 API Key 保存到浏览器；页面中的独立配置仍可覆盖它。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1-8-251228

IMAGE_REQUEST_TIMEOUT_MS=180000
# Optional in local development. Set a stable 32+ character value when
# multiple server instances need to verify the same generation tickets.
GENERATION_TICKET_SECRET=
# Real provider mode is the safe default. Set to true only for intentional
# local fixture demos; mock results are never a substitute for product facts.
NEXT_PUBLIC_USE_MOCK=false

# Build-time, non-secret Evidence/Claim rollout flags.
# Full V2 stack enables Claim-driven enforcement, page planning, visual assets and export.
# Changing these requires a rebuild/restart.
NEXT_PUBLIC_EVIDENCE_CLAIM_PIPELINE_V2=true
NEXT_PUBLIC_EVIDENCE_CLAIM_ENFORCEMENT_V2=true
NEXT_PUBLIC_CLAIM_DRIVEN_PAGE_PLANNING_V2=true
NEXT_PUBLIC_CLAIM_DRIVEN_VISUAL_ASSETS_V2=true
NEXT_PUBLIC_CLAIM_DRIVEN_EXPORT_V2=true

# Local-only mode: no login, no cloud database, no user system.
# Image generation uses its own local "生图 API 设置" and never reuses OPENAI_API_KEY.
